# Copy this file to ".env" and put your own key after the "=".
# The .env file is ignored by git, so your key is never uploaded to GitHub.
ANTHROPIC_API_KEY=

# Web app URL of the Masra email script (tools/welcome_email/Code.gs).
# It sends the welcome email and the password reset email.
# Leave empty to turn welcome emails off.
WELCOME_EMAIL_URL=
